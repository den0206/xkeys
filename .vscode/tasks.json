{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Xkeys Debug.app",
      "type": "process",
      "command": "xcodebuild",
      "args": [
        "-project", "${workspaceFolder}/Xkeys.xcodeproj",
        "-scheme", "Xkeys",
        "-configuration", "Debug",
        "-destination", "platform=macOS",
        "-derivedDataPath", "${workspaceFolder}/.build/xcode",
        "-allowProvisioningUpdates",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "swift",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    }
  ]
}
