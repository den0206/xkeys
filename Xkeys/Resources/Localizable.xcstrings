      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit"
          }
        }
      }
    },
    "APIキーやURLなど、アプリ専用のKeyとValueを登録できます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add app-specific keys and values, such as API keys and URLs."
