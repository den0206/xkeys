  "strings" : {
    "Keyを追加" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add key"
          }
        }
      }
    },
    "「Keyを追加」で複数入力し、最後にまとめて保存できます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Add key to enter multiple entries, then save them together."
          }
        }
      }
    },
    "「%@」の値をコピーしました" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
